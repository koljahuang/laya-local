# Default: multilingual checkpoint with automatic MPS/CPU selection.
LAYA_MODEL=convaiinnovations/laya
LAYA_SUBFOLDER=multilingual
LAYA_DEVICE=auto
LAYA_HOST=127.0.0.1
LAYA_PORT=7860

# Optional: place the Hugging Face cache elsewhere.
# HF_HOME=/path/to/huggingface-cache

# Alternatives:
# English checkpoint: set LAYA_SUBFOLDER to an empty value.
# Typed-decisions checkpoint: LAYA_SUBFOLDER=typed-decisions
# Force CPU: LAYA_DEVICE=cpu
# Force Apple GPU: LAYA_DEVICE=mps
